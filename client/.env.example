# LockA Patient Client — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in values for the network
# you're targeting. All variables are read at build time via `import.meta.env`
# (see src/vite-env.d.ts) and MUST be prefixed with VITE_ to be exposed to the
# client bundle — never put secrets in these, they ship to the browser.

# JSON-RPC endpoint for the target EVM network (LockA runs on Base).
# Base Sepolia (testnet): https://sepolia.base.org
# Base Mainnet:           https://mainnet.base.org
VITE_RPC_URL=https://sepolia.base.org

# Chain ID of the target EVM network. Must match the network the connected
# wallet is on. 84532 = Base Sepolia, 8453 = Base Mainnet.
VITE_CHAIN_ID=84532

# Base URL of the LockA backend API (auth, encrypted record indexing,
# notifications). See LockA-Documentation for the API contract.
VITE_API_BASE_URL=http://localhost:3000

# Deployed contract addresses on the target network.
# PatientPassportRegistry: registers patient passport identities and recovery config.
VITE_PATIENT_PASSPORT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# ProviderRegistry: registers verified healthcare providers and their status.
VITE_PROVIDER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# MedicalRecordRegistry: stores encrypted medical record commitments/hashes.
VITE_MEDICAL_RECORD_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# ConsentAccessManager: patient-provider consent requests, approvals, revocations.
VITE_CONSENT_ACCESS_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
