# LockA Patient Client — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in values for the network
# you're targeting. All variables are read at build time via `import.meta.env`
# (see src/vite-env.d.ts) and MUST be prefixed with VITE_ to be exposed to the
# client bundle — never put secrets in these, they ship to the browser.
#
# LockA runs on Stellar with Soroban smart contracts. Wallet signing is via
# the Freighter browser extension (XLM-compatible), not a private key here.

# Soroban RPC endpoint for the target Stellar network.
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://mainnet.sorobanrpc.com
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase. Must match the network the connected Freighter
# wallet is on — Soroban has no numeric chain ID, the passphrase IS the
# network identifier.
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Base URL of the LockA backend API (auth, encrypted record indexing,
# notifications). See LockA-Documentation for the API contract.
VITE_API_BASE_URL=http://localhost:3000

# --- Local development without deployed contracts ---------------------------
#
# Set to "true" to swap the Soroban contract client for an in-memory mock that
# serves seed data (a registered passport, pending access requests, active and
# revoked grants, records, audit events) after an artificial delay. Nothing
# below this block matters in mock mode — no RPC server, no contract IDs, and
# no Freighter wallet are needed. Writes (approve/deny/revoke/register) apply
# to the in-memory copy and reset on page reload.
VITE_USE_MOCK_CONTRACTS=false

# Optional: simulated round-trip delay for mock calls, in milliseconds
# (default 350). Raise it to inspect loading states, set 0 to remove it.
# VITE_MOCK_CONTRACT_LATENCY_MS=350

# Optional: set to "true" to start the mock with no registered passport, for
# working on the onboarding/registration flow.
# VITE_MOCK_UNREGISTERED_PASSPORT=false

# Deployed Soroban contract IDs on the target network (from locka-contracts).
# Contract IDs are StrKey-encoded and start with "C".
# PatientIdentityRegistry: patient passport identifiers, pubkeys, recovery config.
VITE_PATIENT_IDENTITY_REGISTRY_CONTRACT_ID=
# ProviderRegistry: verified healthcare providers and their authorized staff.
VITE_PROVIDER_REGISTRY_CONTRACT_ID=
# ConsentAccessControl: access requests, approvals, limits, expiry, revocation.
VITE_CONSENT_ACCESS_CONTROL_CONTRACT_ID=
# RecordCommitmentRegistry: hashes/commitments of encrypted medical records.
VITE_RECORD_COMMITMENT_REGISTRY_CONTRACT_ID=
# DeviceAttestationRegistry: approved medical devices / IoT / wearable sources.
VITE_DEVICE_ATTESTATION_REGISTRY_CONTRACT_ID=
# AuditEventEmitter: access/consent/record events that power the audit log.
VITE_AUDIT_EVENT_EMITTER_CONTRACT_ID=
